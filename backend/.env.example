APP_NAME=Solon API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://solon:solon@localhost:5432/solon
LLM_DATABASE_URL=postgresql+asyncpg://solon_llm_readonly:change-me-readonly@localhost:5432/solon
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_INTERNAL_API_KEY=change-me
FRONTEND_USER_AUTH_SECRET=change-me-user-auth
ADMIN_EMAILS=["you@example.com"]

# OpenAI
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-api-key
OPENAI_MODEL=gpt-4.1-mini

# Or Azure OpenAI
# OPENAI_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=replace-with-api-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano
